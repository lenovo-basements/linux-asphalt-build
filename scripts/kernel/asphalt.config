# Apply on top of the current config with:
#   scripts/kconfig/merge_config.sh -m -O <out> <out>/.config asphalt.config
#   make O=<out> olddefconfig

CONFIG_ARM64_PTR_AUTH=y
# CONFIG_ARM64_PTR_AUTH_KERNEL is not set
CONFIG_ARM64_BTI=y
# CONFIG_ARM64_BTI_KERNEL is not set
CONFIG_ARM64_SVE=y
CONFIG_ARM64_AMU_EXTN=y
CONFIG_ARM64_TLB_RANGE=y
CONFIG_ARM64_E0PD=y
CONFIG_ARM64_EPAN=y
# CONFIG_ARM64_MTE is not set
CONFIG_SHADOW_CALL_STACK=y
CONFIG_SLAB_FREELIST_RANDOM=y
CONFIG_SLAB_FREELIST_HARDENED=y
CONFIG_SHUFFLE_PAGE_ALLOCATOR=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_FORTIFY_SOURCE=y
CONFIG_LIST_HARDENED=y
CONFIG_BUG_ON_DATA_CORRUPTION=y
CONFIG_RANDOMIZE_KSTACK_OFFSET=y
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y
CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_ZERO_CALL_USED_REGS=y
CONFIG_KFENCE=y
CONFIG_SECURITY_DMESG_RESTRICT=y
# CONFIG_INIT_ON_FREE_DEFAULT_ON is not set
CONFIG_CFI=y
CONFIG_LTO_NONE=y
# CONFIG_RTC_HCTOSYS is not set
# CONFIG_RTC_SYSTOHC is not set
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
CONFIG_V4L2_MEM2MEM_DEV=y
CONFIG_V4L2_FWNODE=y
CONFIG_VIDEOBUF2_DMA_CONTIG=y
CONFIG_VIDEOBUF2_DMA_SG=y
CONFIG_VIDEO_QCOM_IRIS=y
CONFIG_VIDEO_QCOM_CAMSS=y
CONFIG_I2C_QCOM_CCI=y
CONFIG_VIDEO_OV13B10=y
CONFIG_VIDEO_S5K4H7=y
CONFIG_VIDEO_SC202CS=y
CONFIG_REGULATOR_WL2864C=y
CONFIG_ARCH_QCOM=y
