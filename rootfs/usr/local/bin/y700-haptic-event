#!/usr/bin/env python3
"""
Lenovo Legion Y700 (2023) / TB320FC / asphalt
Ask y700-hapticd (legacy datagram socket) to play an event effect. Best effort: never blocks, never
fails the caller when haptics are unavailable.

Usage: y700-haptic-event EVENT
       y700-haptic-event --after-exit PID EVENT   (e.g. unlock when gtklock exits)
"""
import os
import re
import select
import socket
import sys

SOCKET = os.environ.get("SOCKET", "/run/y700-haptic-rtp.sock")
# Any effect name y700-hapticd knows (it validates); just keep it a plain word.
NAME = re.compile(r"^[a-z0-9][a-z0-9-]{0,47}$")


def send(event):
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as client:
            client.setblocking(False)
            client.sendto(event.encode(), SOCKET)
    except OSError:
        pass


def main(argv):
    pid = None
    if len(argv) == 4 and argv[1] == "--after-exit" and argv[2].isdigit():
        pid = int(argv[2])
        argv = argv[:1] + argv[3:]
    if len(argv) != 2 or not NAME.match(argv[1]):
        print(__doc__.strip(), file=sys.stderr)
        return 2
    if pid is not None:
        try:
            pidfd = os.pidfd_open(pid)
        except OSError:
            return 1
        select.select([pidfd], [], [])
    send(argv[1])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
