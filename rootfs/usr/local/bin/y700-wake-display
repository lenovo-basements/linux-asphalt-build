#!/bin/bash
# Lenovo Legion Y700 (2023) GNOME display wake helper.
# The backlight is unblanked by system-sleep/y700-resume.sh, and Hyprland
# wakes its outputs from hypridle's after_sleep_cmd. Only a running GNOME
# session (Mutter) needs synthetic activity and a PowerSaveMode reset.

as_user() {
    local uid=$1 bus=$2
    shift 2
    # Drop credentials directly: opening a new PAM/logind session here
    # delays the wake operation and races desktop session thaw.
    setpriv --reuid="$uid" --regid="$(id -g "$uid")" --init-groups \
        env XDG_RUNTIME_DIR="/run/user/$uid" DBUS_SESSION_BUS_ADDRESS="unix:path=$bus" "$@"
}

mutter=()
for bus in /run/user/*/bus; do
    [ -S "$bus" ] || continue
    uid=${bus#/run/user/}
    uid=${uid%/bus}
    [ "$uid" -ge 1000 ] 2>/dev/null || continue
    if as_user "$uid" "$bus" timeout -k 1 2 gdbus call --session \
            --dest org.freedesktop.DBus --object-path /org/freedesktop/DBus \
            --method org.freedesktop.DBus.NameHasOwner org.gnome.Mutter.DisplayConfig \
            2>/dev/null | grep -q true; then
        mutter+=("$uid:$bus")
    fi
done
[ "${#mutter[@]}" -gt 0 ] || exit 0

# Register an inert keyboard key and give udev/Mutter time to discover it.
# KEY_WAKEUP alone is classified as a power switch, not desktop activity.
python3 - <<'INPUT'
import subprocess
import time
import evdev
from evdev import ecodes as e
with evdev.UInput(name="y700-resume-activity", events={e.EV_KEY: [
        e.KEY_A, e.KEY_Z, e.KEY_1, e.KEY_0, e.KEY_ENTER, e.KEY_SPACE,
        e.KEY_F13]}) as device:
    subprocess.run(["udevadm", "settle", "--timeout=1"], check=False)
    time.sleep(0.25)
    device.write(e.EV_KEY, e.KEY_F13, 1)
    device.syn()
    time.sleep(0.02)
    device.write(e.EV_KEY, e.KEY_F13, 0)
    device.syn()
    time.sleep(0.25)
INPUT

# Restore Mutter scanout using the existing session bus without PAM.
for entry in "${mutter[@]}"; do
    as_user "${entry%%:*}" "${entry#*:}" timeout -k 1 3 gdbus call --session \
        --dest org.gnome.Mutter.DisplayConfig --object-path /org/gnome/Mutter/DisplayConfig \
        --method org.freedesktop.DBus.Properties.Set \
        org.gnome.Mutter.DisplayConfig PowerSaveMode "<int32 0>" 2>/dev/null || true
done
