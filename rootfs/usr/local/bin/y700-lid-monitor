#!/bin/sh
# Lenovo Legion Y700 (2023) / TB320FC / asphalt
# Hall Effect Lid Sensor Monitor (ROHM BU52053NVX via Qualcomm Sensor Core)
# Monitors the SSC hall stream over sensh/QRTR and reports lid state.

SENSH_BIN="/usr/local/bin/sensh"
[ -x "$SENSH_BIN" ] || SENSH_BIN="/usr/bin/sensh"

if [ ! -x "$SENSH_BIN" ]; then
    echo "Notice: sensh binary not found. Hall lid sensor monitoring requires sensh (FastRPC/QRTR)."
    exit 0
fi

echo "Starting Y700 Hall Effect Lid Sensor monitor..."

# Run sensh in batch mode watching the hall sensor
"$SENSH_BIN" watch hall 2>/dev/null | while read -r line; do
    case "$line" in
        *"closed"*|*"1"*)
            echo "Lid State: CLOSED"
            ;;
        *"opened"*|*"0"*)
            echo "Lid State: OPEN"
            ;;
    esac
done
