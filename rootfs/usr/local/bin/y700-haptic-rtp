#!/usr/bin/env python3
"""
Lenovo Legion Y700 (2023) / TB320FC / asphalt
Play a fixed set of RTP haptic effects for session and system events.

Raw RTP streaming (rtp, rtp_mode) stays root-only: arbitrary PCM could hold a
motor at full drive. This daemon is socket-activated by y700-haptic-rtp.socket,
which only the "input" group may write to, and accepts only the event names in
EFFECTS, one datagram each, plus "charger" from udev (see charger_event).
Effects are Lenovo's vendor RTP files (8-bit signed PCM at 24 kHz), shipped
unmodified in asphalt-firmware/awinic and installed to FIRMWARE. One effect
plays at a time; requests that arrive meanwhile are dropped, never queued. The
daemon exits when idle.

FIRMWARE and STATE can be overridden for testing.
"""
import os
import select
import socket
import sys
import threading
import time

FIRMWARE = os.environ.get("FIRMWARE", "/lib/firmware/awinic")
STATE = os.environ.get("STATE", "/run/y700-haptic-rtp")
# event: (vendor file, seconds to keep or None for all, peak to scale to or None)
EFFECTS = {
    "notify": ("159_Drip_RTP.bin", None, None),
    # Lenovo authored these two far quieter (peaks 45 and 20) than Drip (100).
    "charge-on": ("241_Pulse_RTP.bin", None, 100),
    "charge-off": ("243_Light_RTP.bin", None, 100),
    "lock": ("246_kick_RTP.bin", None, None),
    "unlock": ("242_Starlight_RTP.bin", None, None),
    # The opening swell; it ends in silence at 2.1 s, the rest is a 25 s ringtone.
    "login": ("237_Legion_RTP.bin", 2.2, None),
}
CHARGER = "/sys/class/power_supply/qcom-battmgr-usb/online"
# AW86927 motors, each on its own 400 kHz I2C bus. 24 KB/s is over half of
# what one bus carries, so each motor streams from its own thread.
MOTORS = ("/sys/bus/i2c/devices/11-005a", "/sys/bus/i2c/devices/13-005a")
RATE = 24000
LEVEL = 128  # PLAYCFG2 gain; 0x80 is 1.0x
MAX_SECONDS = 5
CHUNK = 256
# The FIFO is the ~2 KB of SRAM below the waveform base (0x0800); stay well under it.
LEAD = 1024
# CLOCK_BOOTTIME keeps counting through suspend: a jump means the chip lost the stream.
STALL = 0.2
IDLE_EXIT = 120


def put(device, name, value):
    with open(f"{device}/{name}", "w") as attribute:
        attribute.write(f"{value}\n")


def stream(device, data, clock=lambda: time.clock_gettime(time.CLOCK_BOOTTIME), sleep=time.sleep):
    put(device, "activate", 0)
    put(device, "level", LEVEL)
    put(device, "rtp_mode", 1)
    try:
        fd = os.open(f"{device}/rtp", os.O_WRONLY)
        try:
            start = clock()
            sent = 0
            while sent < len(data):
                played = (clock() - start) * RATE
                if played - sent > STALL * RATE:
                    return False
                if sent - played > LEAD:
                    sleep(max(0.002, (sent - played - LEAD) / RATE))
                    continue
                sent += os.pwrite(fd, data[sent:sent + CHUNK], 0)
            # Let the FIFO drain before leaving RTP mode.
            sleep(max(0.0, sent / RATE - (clock() - start)) + 0.02)
            return True
        finally:
            os.close(fd)
    finally:
        put(device, "rtp_mode", 0)


def play(data):
    threads = [threading.Thread(target=stream_quietly, args=(device, data)) for device in MOTORS]
    for thread in threads:
        thread.start()
    for thread in threads:
        thread.join()


def stream_quietly(device, data):
    try:
        stream(device, data)
    except OSError as error:
        print(f"{device}: {error}", file=sys.stderr)


def scale(data, peak):
    """Scale 8-bit signed PCM so its largest sample reaches peak."""
    samples = [b - 256 if b > 127 else b for b in data]
    largest = max((abs(s) for s in samples), default=0)
    if not largest:
        return data
    return bytes(max(-127, min(127, round(s * peak / largest))) & 0xff for s in samples)


def load(event):
    if event not in EFFECTS:
        return None
    name, seconds, peak = EFFECTS[event]
    try:
        with open(f"{FIRMWARE}/{name}", "rb") as effect:
            data = effect.read(int(RATE * min(seconds or MAX_SECONDS, MAX_SECONDS)))
    except OSError:
        return None
    return scale(data, peak) if peak else data


def charger_event():
    """Turn a udev change on the USB supply into charge-on/off, once per transition."""
    try:
        with open(CHARGER) as online:
            now = online.read().strip()
    except OSError:
        return None
    path = f"{STATE}/charger-online"
    try:
        with open(path) as last:
            before = last.read().strip()
    except OSError:
        before = None
    if now == before:
        return None
    with open(f"{path}.new", "w") as last:
        last.write(now + "\n")
    os.replace(f"{path}.new", path)
    # The first event after boot only records the state.
    if before is None:
        return None
    return "charge-on" if now == "1" else "charge-off"


class Player:
    def __init__(self, play=play):
        self.play = play
        self.busy = threading.Lock()

    def request(self, event):
        if event == "charger":
            event = charger_event()
        data = load(event) if event else None
        if not data or not self.busy.acquire(blocking=False):
            return False
        threading.Thread(target=self.run, args=(data,), daemon=True).start()
        return True

    def run(self, data):
        try:
            self.play(data)
        finally:
            self.busy.release()


def main():
    if os.environ.get("LISTEN_FDS") != "1" or os.environ.get("LISTEN_PID") != str(os.getpid()):
        print("Start through y700-haptic-rtp.socket", file=sys.stderr)
        return 2
    listener = socket.socket(fileno=3)
    player = Player()
    while True:
        ready, _, _ = select.select([listener], [], [], IDLE_EXIT)
        if not ready:
            if player.busy.acquire(blocking=False):
                return 0
            continue
        message = listener.recv(32)
        player.request(message.decode("ascii", errors="replace").strip())


if __name__ == "__main__":
    sys.exit(main())
