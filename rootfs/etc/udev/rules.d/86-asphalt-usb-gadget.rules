ACTION=="add", SUBSYSTEM=="udc", TAG+="systemd", ENV{SYSTEMD_WANTS}+="asphalt-usb-gadget.service"
ACTION=="remove", SUBSYSTEM=="udc", RUN+="/usr/bin/systemctl --no-block stop asphalt-usb-gadget.service"
ACTION=="add|change", SUBSYSTEM=="net", ENV{DEVTYPE}=="gadget", KERNEL=="usb0", ENV{NM_UNMANAGED}="0"
