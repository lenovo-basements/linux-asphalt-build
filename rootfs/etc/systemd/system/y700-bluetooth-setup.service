[Unit]
Description=Lenovo Legion Y700 Bluetooth Address Initializer
Before=bluetooth.service
Wants=bluetooth.service
After=sys-subsystem-bluetooth-devices-hci0.device

[Service]
Type=oneshot
ExecStart=/usr/local/bin/y700-bluetooth-setup
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target bluetooth.target
