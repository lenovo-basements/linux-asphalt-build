[Unit]
Description=Lenovo Legion Y700 Camera Power Initializer (WL2864C)
DefaultDependencies=no
After=systemd-modules-load.service
Before=sysinit.target shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/local/bin/y700-camera-power
RemainAfterExit=yes
TimeoutStartSec=15s

[Install]
WantedBy=sysinit.target
