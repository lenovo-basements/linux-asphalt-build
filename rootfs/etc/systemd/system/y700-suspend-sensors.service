[Unit]
Description=Pause Y700 rotation and ambient-light clients across system sleep
Before=sleep.target
StopWhenUnneeded=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/y700-suspend-sensors pause
# Cleanup also restores subscriptions if preparing suspend failed.
ExecStopPost=/usr/local/bin/y700-suspend-sensors resume
TimeoutStartSec=10
TimeoutStopSec=10

[Install]
RequiredBy=sleep.target
