// Permit only the charging helper for an active, local tablet administrator.
polkit.addRule(function(action, subject) {
    if (action.id !== 'local.lenovo.y700.charge')
        return;

    if (action.lookup('program') === '/usr/local/bin/y700-bypass-charge' &&
        subject.local && subject.active && subject.isInGroup('wheel')) {
        return polkit.Result.YES;
    }
    // Explicitly deny this action elsewhere, including cached authentication.
    return polkit.Result.NO;
});
