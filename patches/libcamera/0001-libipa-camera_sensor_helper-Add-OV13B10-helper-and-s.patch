From c57c862f1b0b134c8fdfe38bb8b477054c8d5ead Mon Sep 17 00:00:00 2001
From: lolipuru <banstellazz@gmail.com>
Date: Fri, 13 Nov 2026 03:40:55 +0700
Subject: [PATCH] libipa: camera_sensor_helper: Add OV13B10 helper and sensor
 properties

Add a camera sensor helper and sensor properties for the OmniVision
OV13B10, a 13MP 1.12um sensor (used e.g. as the rear camera of the
Lenovo Legion Y700 Gen 2).

The kernel driver exposes the analogue gain as code / 128, from 0x80
(1x) to 0x7c0 (15.5x), the same linear model as the OV13858. The black
level is 64 at 10 bits: a raw RAW10 frame with the lens covered and the
analogue gain at its maximum has a median of exactly 64 (per Bayer phase
means 64.07 and 63.97). Without the helper the soft IPA falls back to a
black level of 48, and its AWB ends up correcting that offset instead of
the scene.

The driver's test pattern menu is "Disabled" followed by four vertical
colour bar variants; map the first one to TestPatternModeColorBars.

Assisted-by: LLM
Signed-off-by: lolipuru <banstellazz@gmail.com>
---
 src/ipa/libipa/camera_sensor_helper.cpp           | 13 +++++++++++++
 src/libcamera/sensor/camera_sensor_properties.cpp | 14 ++++++++++++++
 2 files changed, 27 insertions(+)

diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
index 9457d62..9b06397 100644
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -827,6 +827,19 @@ public:
 };
 REGISTER_CAMERA_SENSOR_HELPER("ov13858", CameraSensorHelperOv13858)
 
+class CameraSensorHelperOv13b10 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperOv13b10()
+	{
+		/* Black level of 64 at 10 bits */
+		blackLevel_ = 4096;
+		/* Analogue gain = code / 128, 0x80 (1x) to 0x7c0 (15.5x) */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 128 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("ov13b10", CameraSensorHelperOv13b10)
+
 class CameraSensorHelperVd55g1 : public CameraSensorHelper
 {
 public:
diff --git a/src/libcamera/sensor/camera_sensor_properties.cpp b/src/libcamera/sensor/camera_sensor_properties.cpp
index 2804315..d564368 100644
--- a/src/libcamera/sensor/camera_sensor_properties.cpp
+++ b/src/libcamera/sensor/camera_sensor_properties.cpp
@@ -503,6 +503,20 @@ const CameraSensorProperties *CameraSensorProperties::get(const std::string &sen
 			},
 			.sensorDelays = { },
 		} },
+		{ "ov13b10", {
+			.unitCellSize = { 1120, 1120 },
+			.testPatternModes = {
+				{ controls::draft::TestPatternModeOff, 0 },
+				{ controls::draft::TestPatternModeColorBars, 1 },
+				/*
+				 * No corresponding test pattern mode for:
+				 * 2: "Vertical Color Bar Type 2"
+				 * 3: "Vertical Color Bar Type 3"
+				 * 4: "Vertical Color Bar Type 4"
+				 */
+			},
+			.sensorDelays = { },
+		} },
 		{ "vd55g1", {
 			.unitCellSize = { 2160, 2160 },
 			.testPatternModes = {
-- 
