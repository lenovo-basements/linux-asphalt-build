+
+static std::optional<RGB<float>> tiledGains(const SwIspStats &stats, uint8_t blackLevel,
+					   const std::array<float, 4> &neutralRange)
+{
+	const auto &[daylightRed, daylightBlue, tungstenRed, tungstenBlue] = neutralRange;
+	const float redRange = tungstenRed - daylightRed;
+	const float blueRange = tungstenBlue - daylightBlue;
+	const float rangeSquared = redRange * redRange + blueRange * blueRange;
+	constexpr float tolerance = 0.075f;
+
+	std::vector<float> redGains, blueGains;
+	for (unsigned int i = 0; i < stats.awbTileCount; ++i) {
+		const auto &tile = stats.awbTiles[i];
+		const float black = static_cast<float>(blackLevel) * tile.count;
+		const float red = tile.red - black;
+		const float green = tile.green - black;
+		const float blue = tile.blue - black;
+		if (!tile.count || std::min({ red, green, blue }) < 2.0f * tile.count)
+			continue;
+
+		const float rg = red / green - daylightRed;
+		const float bg = blue / green - daylightBlue;
+		const float fraction = std::clamp((rg * redRange + bg * blueRange) /
+						  rangeSquared,
+						  0.0f, 1.0f);
+		const float dr = rg - fraction * redRange;
+		const float db = bg - fraction * blueRange;
+		if (dr * dr + db * db <= tolerance * tolerance) {
+			redGains.push_back(green / red);
+			blueGains.push_back(green / blue);
+		}
+	}
+
+	if (redGains.size() < std::max(8u, stats.awbTileCount / 20))
+		return std::nullopt;
+
+	auto median = [](std::vector<float> &values) {
+		auto mid = values.begin() + values.size() / 2;
+		std::nth_element(values.begin(), mid, values.end());
+		return *mid;
+	};
+	LOG(IPASoftAwb, Debug) << "Using " << redGains.size() << " neutral tiles";
+	return RGB<float>{ { median(redGains), 1.0f, median(blueGains) } };
 }
 
