+int Awb::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	const auto &tiled = tuningData["tiled"];
+	if (!tiled.isDictionary())
+		return 0;
+
+	const auto &daylight = tiled["daylight"];
+	const auto &tungsten = tiled["tungsten"];
+	std::array<float, 4> range{ daylight[0].get<float>(0.0f),
+				   daylight[1].get<float>(0.0f),
+				   tungsten[0].get<float>(0.0f),
+				   tungsten[1].get<float>(0.0f) };
+	if (std::any_of(range.begin(), range.end(), [](float value) {
+		    return !(value >= 0.25f && value <= 4.0f);
+	    }) || (range[0] == range[2] && range[1] == range[3])) {
+		LOG(IPASoftAwb, Warning) << "Invalid tiled AWB neutral range";
+		return 0;
+	}
+
+	neutralRange_ = range;
+	return 0;
+}
 
