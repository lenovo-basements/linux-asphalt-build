+void SwStatsCpu::processAwbTiles(const MappedFrameBuffer &in, Size size)
+{
+	constexpr unsigned int tileSize = 128;
+	constexpr unsigned int sampleStep = 8;
+	constexpr unsigned int clippingThreshold = 251;
+	const unsigned int columns = (size.width + tileSize - 1) / tileSize;
+	const unsigned int rows = (size.height + tileSize - 1) / tileSize;
+	if (columns * rows > sharedStats_->awbTiles.size())
+		return;
+
+	const uint8_t *data = in.planes()[0].data();
+	for (unsigned int ty = 0; ty < rows; ++ty) {
+		for (unsigned int tx = 0; tx < columns; ++tx) {
+			SwIspStats::AwbTile tile{};
+			const unsigned int bottom = std::min(size.height - 1, (ty + 1) * tileSize);
+			const unsigned int right = std::min(size.width - 1, (tx + 1) * tileSize);
+			for (unsigned int y = ty * tileSize; y < bottom; y += sampleStep) {
+				const uint8_t *top = data + y * stride_;
+				const uint8_t *next = top + stride_;
+				for (unsigned int x = tx * tileSize; x < right; x += sampleStep) {
+					const unsigned int i = x * 5 / 4;
+					const unsigned int blue = top[i];
+					const unsigned int green0 = top[i + 1];
+					const unsigned int green1 = next[i];
+					const unsigned int red = next[i + 1];
+					if (std::max({ red, green0, green1, blue }) >= clippingThreshold)
+						continue;
+					tile.red += red;
+					tile.green += (green0 + green1) / 2;
+					tile.blue += blue;
+					++tile.count;
+				}
+			}
+			sharedStats_->awbTiles[sharedStats_->awbTileCount++] = tile;
+		}
+	}
+}
