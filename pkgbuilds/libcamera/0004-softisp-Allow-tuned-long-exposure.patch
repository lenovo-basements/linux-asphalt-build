+int Agc::configure(IPAContext &context, const IPAConfigInfo &configInfo)
+{
+	auto &agc = context.configuration.agc;
+	agc.longExposureMax = agc.exposureMax;
+
+	const auto &timing = configInfo.sensorInfo;
+	const auto vblank = configInfo.sensorControls.find(V4L2_CID_VBLANK);
+	if (!maxExposureTime_ || vblank == configInfo.sensorControls.end() ||
+	    !timing.outputSize.height || !timing.pixelRate || !timing.minLineLength)
+		return 0;
+
+	/*
+	 * This tuning option requires a driver whose exposure limit tracks
+	 * vertical blanking. Derive its exposure margin at the default mode
+	 * timing and bound the shutter by both tuning and the hardware limit.
+	 */
+	const ControlInfo &info = vblank->second;
+	const int32_t defaultVblank = info.def().get<int32_t>();
+	const int32_t frameHeight = timing.outputSize.height;
+	const int32_t margin = frameHeight + defaultVblank - agc.exposureMax;
+	if (margin < 0)
+		return 0;
+
+	const int32_t hardwareMax = frameHeight + info.max().get<int32_t>() - margin;
+	const utils::Duration lineDuration = timing.minLineLength * 1.0s / timing.pixelRate;
+	const double tuningMax = maxExposureTime_ / lineDuration.get<std::micro>();
+	const int32_t limit = std::min<double>(hardwareMax, tuningMax);
+	if (limit > agc.exposureMax) {
+		agc.longExposureMax = limit;
+		agc.lineDuration = lineDuration;
+		agc.defaultVblank = defaultVblank;
+		agc.frameHeight = frameHeight;
+		agc.exposureMargin = margin;
+	}
+	return 0;
+}
