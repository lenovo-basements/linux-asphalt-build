diff --git a/src/ipa/simple/algorithms/lsc.cpp b/src/ipa/simple/algorithms/lsc.cpp
new file mode 100644
index 0000000..2a5644a
--- /dev/null
+++ b/src/ipa/simple/algorithms/lsc.cpp
@@ -0,0 +1,137 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Lens shading correction
+ *
+ * Tuning (per sensor):
+ *
+ *   - Lsc:
+ *       meshes:
+ *         - ct: 5000
+ *           r: [ 221 gains, 17 x 13, row-major, top-left first ]
+ *           g: [ ... ]
+ *           b: [ ... ]
+ *
+ * Nodes span the image edge to edge. The mesh for the AWB colour temperature
+ * is interpolated between the two nearest entries and handed to the debayer
+ * as an RGBA8 texture; the GPU interpolates between nodes.
+ */
+
+#include "lsc.h"
+
+#include <algorithm>
+#include <cmath>
+
+#include <libcamera/base/log.h>
+#include <libcamera/base/utils.h>
+
+namespace {
+
+constexpr unsigned int kTemperatureThreshold = 100;
+
+}
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftLsc)
+
+int Lsc::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	static const char *const channels[] = { "r", "g", "b" };
+
+	for (const auto &node : tuningData["meshes"].asList()) {
+		Mesh mesh;
+		mesh.ct = node["ct"].get<unsigned int>(0);
+		for (unsigned int c = 0; c < 3; c++) {
+			const ValueNode &list = node[channels[c]];
+			if (!list.isList() || list.size() != kNodes) {
+				LOG(IPASoftLsc, Error)
+					<< "Mesh for " << mesh.ct << "K: '" << channels[c]
+					<< "' needs " << kNodes << " gains";
+				return -EINVAL;
+			}
+			unsigned int i = 0;
+			for (const auto &value : list.asList()) {
+				const float gain = value.get<float>(1.0f);
+				if (!std::isfinite(gain) || gain < 0.5f || gain > 16.0f) {
+					LOG(IPASoftLsc, Error) << "Gain out of range: " << gain;
+					return -EINVAL;
+				}
+				mesh.gains[c][i++] = gain;
+			}
+		}
+		meshes_.push_back(mesh);
+	}
+
+	if (meshes_.empty()) {
+		LOG(IPASoftLsc, Error) << "No 'meshes' in the Lsc tuning";
+		return -EINVAL;
+	}
+
+	std::sort(meshes_.begin(), meshes_.end(),
+		  [](const Mesh &a, const Mesh &b) { return a.ct < b.ct; });
+	return 0;
+}
+
+void Lsc::encode(unsigned int ct, DebayerParams *params)
+{
+	/* Linear in colour temperature between the two nearest meshes. */
+	const Mesh *lo = &meshes_.front(), *hi = &meshes_.front();
+	float t = 0.0f;
+	if (ct >= meshes_.back().ct) {
+		lo = hi = &meshes_.back();
+	} else if (ct > meshes_.front().ct) {
+		auto it = std::find_if(meshes_.begin(), meshes_.end(),
+				       [ct](const Mesh &m) { return m.ct >= ct; });
+		hi = &*it;
+		lo = &*(it - 1);
+		t = static_cast<float>(ct - lo->ct) / (hi->ct - lo->ct);
+	}
+
+	std::array<std::array<float, kNodes>, 3> gains;
+	float maxGain = 1.0f;
+	for (unsigned int c = 0; c < 3; c++) {
+		for (unsigned int i = 0; i < kNodes; i++) {
+			gains[c][i] = lo->gains[c][i] + t * (hi->gains[c][i] - lo->gains[c][i]);
+			maxGain = std::max(maxGain, gains[c][i]);
+		}
+	}
+
+	/* 8 bits over [1, maxGain]: gains below 1 aren't corrected. */
+	const float range = maxGain - 1.0f;
+	for (unsigned int i = 0; i < kNodes; i++) {
+		for (unsigned int c = 0; c < 3; c++) {
+			const float v = range > 0.0f ? (gains[c][i] - 1.0f) / range : 0.0f;
+			params->lscMesh[i * 4 + c] =
+				static_cast<uint8_t>(std::lround(std::clamp(v, 0.0f, 1.0f) * 255.0f));
+		}
+		params->lscMesh[i * 4 + 3] = 255;
+	}
+	params->lscRange = range;
+	params->lscRevision = ++revision_;
+}
+
+void Lsc::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		  [[maybe_unused]] IPAFrameContext &frameContext,
+		  DebayerParams *params)
+{
+	const unsigned int ct = context.activeState.awb.temperatureK;
+
+	/*
+	 * params is shared with the debayer and outlives frames: re-encode on a
+	 * bigger temperature change, or if the mesh was never written.
+	 */
+	if (revision_ && params->lscRevision == revision_ &&
+	    utils::abs_diff(ct, lastCt_) < kTemperatureThreshold)
+		return;
+
+	encode(ct, params);
+	lastCt_ = ct;
+}
+
+REGISTER_IPA_ALGORITHM(Lsc, "Lsc")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
diff --git a/src/ipa/simple/algorithms/lsc.h b/src/ipa/simple/algorithms/lsc.h
new file mode 100644
index 0000000..f666ee3
--- /dev/null
+++ b/src/ipa/simple/algorithms/lsc.h
@@ -0,0 +1,47 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Lens shading correction
+ */
+
+#pragma once
+
+#include <array>
+#include <vector>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Lsc : public Algorithm
+{
+public:
+	Lsc() = default;
+	~Lsc() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	void prepare(IPAContext &context,
+		     const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DebayerParams *params) override;
+
+private:
+	static constexpr unsigned int kNodes =
+		DebayerParams::kLscWidth * DebayerParams::kLscHeight;
+
+	struct Mesh {
+		unsigned int ct;
+		std::array<std::array<float, kNodes>, 3> gains; /* R, G, B */
+	};
+
+	void encode(unsigned int ct, DebayerParams *params);
+
+	std::vector<Mesh> meshes_;
+	unsigned int lastCt_ = 0;
+	uint32_t revision_ = 0;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
