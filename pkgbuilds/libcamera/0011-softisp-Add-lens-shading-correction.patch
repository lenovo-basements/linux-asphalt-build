diff --git a/src/libcamera/shaders/bayer_1x_packed.frag b/src/libcamera/shaders/bayer_1x_packed.frag
index 0b641a5..aee08b4 100644
--- a/src/libcamera/shaders/bayer_1x_packed.frag
+++ b/src/libcamera/shaders/bayer_1x_packed.frag
@@ -71,6 +71,20 @@ uniform vec3 blacklevel;
 uniform float gamma;
 uniform float contrastExp;
 
+/*
+ * Lens shading: 17x13 R/G/B gain mesh spanning the image edge to edge,
+ * gain = 1 + texel * lsc_range (0 = off). Nodes sit on texel centres.
+ */
+uniform sampler2D       lsc_tex;
+uniform float           lsc_range;
+
+vec3 lsc_gain(vec2 pos)
+{
+    const vec2 nodes = vec2(17.0, 13.0);
+    vec2 t = (clamp(pos, 0.0, 1.0) * (nodes - 1.0) + 0.5) / nodes;
+    return vec3(1.0) + texture2D(lsc_tex, t).rgb * lsc_range;
+}
+
 float apply_contrast(float value)
 {
 	// Apply simple S-curve
@@ -232,6 +246,9 @@ void main(void)
 	 */
 	rgb = (rgb - blacklevel) / (1.0 - blacklevel);
 
+	if (lsc_range > 0.0)
+		rgb *= lsc_gain(textureOut);
+
 	/* Apply AWB gains, and saturate each channel at sensor range */
 	rgb = clamp(rgb * awb, vec3(0.0), vec3(1.0));
 
