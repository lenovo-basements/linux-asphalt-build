diff --git a/src/libcamera/software_isp/debayer_egl.cpp b/src/libcamera/software_isp/debayer_egl.cpp
index b154fb4..db50089 100644
--- a/src/libcamera/software_isp/debayer_egl.cpp
+++ b/src/libcamera/software_isp/debayer_egl.cpp
@@ -121,6 +121,8 @@ int DebayerEGL::getShaderVariableLocations(void)
 	blackLevelUniformDataIn_ = glGetUniformLocation(programId_, "blacklevel");
 	gammaUniformDataIn_ = glGetUniformLocation(programId_, "gamma");
 	contrastExpUniformDataIn_ = glGetUniformLocation(programId_, "contrastExp");
+	lscTextureUniform_ = glGetUniformLocation(programId_, "lsc_tex");
+	lscRangeUniform_ = glGetUniformLocation(programId_, "lsc_range");
 
 	textureUniformStep_ = glGetUniformLocation(programId_, "tex_step");
 	textureUniformSize_ = glGetUniformLocation(programId_, "tex_size");
@@ -504,6 +506,37 @@ void DebayerEGL::setShaderVariableValues(eGLImage &eglImageIn, const DebayerPara
 	glUniform1f(contrastExpUniformDataIn_, params.contrastExp);
 	LOG(Debayer, Debug) << " contrastExpUniformDataIn_ " << contrastExpUniformDataIn_ << " data " << params.contrastExp;
 
+	/*
+	 * Lens shading: a small RGBA8 mesh, linearly filtered by the GPU. The
+	 * shader skips it while lsc_range is 0 (no Lsc tuning).
+	 */
+	const bool lsc = params.lscRange > 0.0f && lscTextureUniform_ >= 0;
+	if (lsc && params.lscRevision != lscRevision_) {
+		if (!lscTexture_)
+			glGenTextures(1, &lscTexture_);
+		glActiveTexture(GL_TEXTURE2);
+		glBindTexture(GL_TEXTURE_2D, lscTexture_);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+		glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+		glPixelStorei(GL_UNPACK_ALIGNMENT, 4);
+		glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA, DebayerParams::kLscWidth,
+			     DebayerParams::kLscHeight, 0, GL_RGBA, GL_UNSIGNED_BYTE,
+			     params.lscMesh.data());
+		glActiveTexture(GL_TEXTURE0);
+		lscRevision_ = params.lscRevision;
+		LOG(Debayer, Debug) << "LSC mesh revision " << lscRevision_
+				    << " range " << params.lscRange;
+	}
+	if (lsc && lscTexture_) {
+		glActiveTexture(GL_TEXTURE2);
+		glBindTexture(GL_TEXTURE_2D, lscTexture_);
+		glActiveTexture(GL_TEXTURE0);
+		glUniform1i(lscTextureUniform_, 2);
+	}
+	glUniform1f(lscRangeUniform_, lsc && lscTexture_ ? params.lscRange : 0.0f);
+
 	return;
 }
 
@@ -699,6 +732,11 @@ void DebayerEGL::stop()
 	eglImageOutCache_.clear();
 	eglImageInCache_.clear();
 
+	if (lscTexture_)
+		glDeleteTextures(1, &lscTexture_);
+	lscTexture_ = 0;
+	lscRevision_ = 0;
+
 	if (programId_)
 		glDeleteProgram(programId_);
 }
