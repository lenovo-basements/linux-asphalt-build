 	denoiseLuma_ = glGetUniformLocation(denoiseProgramId_, "lumaSigma");
 	denoiseChroma_ = glGetUniformLocation(denoiseProgramId_, "chromaSigma");
+	sharpenAmount_ = glGetUniformLocation(denoiseProgramId_, "sharpenAmount");
+	sharpenThreshold_ = glGetUniformLocation(denoiseProgramId_, "sharpenThreshold");
 
 	return 0;
 }
@@ -387,6 +389,8 @@ void DebayerEGL::drawDenoise(const DebayerParams &params)
 	glUniform2f(denoiseTexel_, 1.0f / width_, 1.0f / height_);
 	glUniform1f(denoiseLuma_, params.denoiseLuma);
 	glUniform1f(denoiseChroma_, params.denoiseChroma);
+	glUniform1f(sharpenAmount_, params.sharpenAmount);
+	glUniform1f(sharpenThreshold_, params.sharpenThreshold);
 
 	glViewport(0, 0, width_, height_);
 	glDrawArrays(GL_TRIANGLE_FAN, 0, DEBAYER_OPENGL_COORDS);
@@ -743,9 +747,10 @@ int DebayerEGL::debayerGPU(FrameBuffer *input, FrameBuffer *output, const Debaye
 	if (!eglImageOut)
 		return -ENOMEM;
 
-	/* With denoise, the debayer draws into the intermediate target first. */
+	/* With denoise or sharpening, the debayer draws into the intermediate target first. */
 	const bool denoise = denoiseProgramId_ &&
-			     (params.denoiseLuma > 0.0f || params.denoiseChroma > 0.0f) &&
+			     (params.denoiseLuma > 0.0f || params.denoiseChroma > 0.0f ||
+			      params.sharpenAmount > 0.0f) &&
 			     prepareDenoiseTarget() == 0;
 
 	egl_.useProgram(programId_);
