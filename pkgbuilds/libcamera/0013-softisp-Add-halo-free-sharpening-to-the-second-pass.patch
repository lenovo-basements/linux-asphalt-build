diff --git a/src/ipa/simple/algorithms/sharpen.cpp b/src/ipa/simple/algorithms/sharpen.cpp
new file mode 100644
index 0000000..13ef450
--- /dev/null
+++ b/src/ipa/simple/algorithms/sharpen.cpp
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Sharpening strength
+ *
+ * Tuning (per sensor), amount piecewise linear in analogue gain:
+ *
+ *   - Sharpen:
+ *       gain:      [ 1.0, 4.0, 16.0 ]
+ *       amount:    [ 0.7, 0.4, 0.1 ]
+ *       threshold: 0.008
+ *
+ * amount is the unsharp mask gain on luma, threshold the detail (gamma-
+ * encoded units) below which nothing is sharpened (see denoise.frag). Less
+ * at high gain, where most of the detail left is noise.
+ */
+
+#include "sharpen.h"
+
+#include <algorithm>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftSharpen)
+
+int Sharpen::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	for (const auto &[node, out] : { std::pair{ &tuningData["gain"], &gains_ },
+					 std::pair{ &tuningData["amount"], &amounts_ } }) {
+		if (!node->isList())
+			break;
+		for (const auto &value : node->asList()) {
+			const auto v = value.get<float>();
+			if (!v)
+				break;
+			out->push_back(*v);
+		}
+	}
+	threshold_ = tuningData["threshold"].get<float>(0.0f);
+
+	if (gains_.empty() || gains_.size() != amounts_.size() ||
+	    !std::is_sorted(gains_.begin(), gains_.end()) || threshold_ < 0.0f) {
+		LOG(IPASoftSharpen, Error)
+			<< "Sharpen needs 'gain' and 'amount' lists of the same length,"
+			<< " gain ascending, and a non-negative 'threshold'";
+		return -EINVAL;
+	}
+	return 0;
+}
+
+void Sharpen::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      DebayerParams *params)
+{
+	const float gain = context.activeState.agc.again;
+	float amount;
+
+	if (gain <= gains_.front()) {
+		amount = amounts_.front();
+	} else if (gain >= gains_.back()) {
+		amount = amounts_.back();
+	} else {
+		const size_t i = std::upper_bound(gains_.begin(), gains_.end(), gain) - gains_.begin();
+		const float t = (gain - gains_[i - 1]) / (gains_[i] - gains_[i - 1]);
+		amount = amounts_[i - 1] + t * (amounts_[i] - amounts_[i - 1]);
+	}
+
+	params->sharpenAmount = std::max(0.0f, amount);
+	params->sharpenThreshold = threshold_;
+}
+
+REGISTER_IPA_ALGORITHM(Sharpen, "Sharpen")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
diff --git a/src/ipa/simple/algorithms/sharpen.h b/src/ipa/simple/algorithms/sharpen.h
new file mode 100644
index 0000000..1379bf2
--- /dev/null
+++ b/src/ipa/simple/algorithms/sharpen.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Sharpening strength
+ */
+
+#pragma once
+
+#include <vector>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Sharpen : public Algorithm
+{
+public:
+	Sharpen() = default;
+	~Sharpen() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	void prepare(IPAContext &context,
+		     const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     DebayerParams *params) override;
+
+private:
+	std::vector<float> gains_;
+	std::vector<float> amounts_;
+	float threshold_ = 0.0f;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
diff --git a/src/libcamera/shaders/denoise.frag b/src/libcamera/shaders/denoise.frag
index d04ccd9..20e16d8 100644
--- a/src/libcamera/shaders/denoise.frag
+++ b/src/libcamera/shaders/denoise.frag
@@ -1,6 +1,7 @@
 /* SPDX-License-Identifier: BSD-2-Clause */
 /*
- * denoise.frag - Edge-aware denoise of the debayered, gamma-encoded frame
+ * denoise.frag - Edge-aware denoise and sharpening of the debayered,
+ * gamma-encoded frame
  *
  * Luma: a 5x5 bilateral, tight in range, so fine grain goes and edges stay.
  * Chroma: a 5x5 bilateral at a 2-pixel stride (9x9 reach) weighted by luma
@@ -9,6 +10,11 @@
  *
  * lumaSigma / chromaSigma are range tolerances in gamma-encoded units
  * (0 disables that part); the IPA raises them with sensor gain.
+ *
+ * Sharpening: an unsharp mask on the (denoised) luma against a Gaussian blur
+ * of the same 5x5 taps. Detail below sharpenThreshold is cored away so the
+ * remaining noise isn't amplified, and the result is held within the 3x3
+ * neighbourhood's luma range plus a small margin, so edges get no halos.
  */
 
 #ifdef GL_ES
@@ -19,6 +25,8 @@ uniform sampler2D tex;
 uniform vec2 texel;
 uniform float lumaSigma;
 uniform float chromaSigma;
+uniform float sharpenAmount;
+uniform float sharpenThreshold;
 
 varying vec2 textureOut;
 
@@ -40,6 +48,10 @@ void main(void)
 	float wL = 0.0;
 	vec3 sumC = vec3(0.0);
 	float wC = 0.0;
+	float sumB = 0.0;
+	float wB = 0.0;
+	float yMin = y0;
+	float yMax = y0;
 
 	for (int j = -2; j <= 2; j++) {
 		for (int i = -2; i <= 2; i++) {
@@ -47,11 +59,20 @@ void main(void)
 			float spatial = dot(o, o) / 4.5;
 
 			vec3 s = texture2D(tex, textureOut + o * texel).rgb;
-			float d = luma(s) - y0;
+			float ys = luma(s);
+			float d = ys - y0;
 			float w = exp(-spatial - d * d * lumaInv);
 			sumL += s * w;
 			wL += w;
 
+			float wb = exp(-spatial);
+			sumB += ys * wb;
+			wB += wb;
+			if (abs(i) <= 1 && abs(j) <= 1) {
+				yMin = min(yMin, ys);
+				yMax = max(yMax, ys);
+			}
+
 			vec3 s2 = texture2D(tex, textureOut + 2.0 * o * texel).rgb;
 			float d2 = luma(s2) - y0;
 			float w2 = exp(-spatial - d2 * d2 * chromaInv);
@@ -64,6 +85,14 @@ void main(void)
 	vec3 chromaPart = chromaSigma > 0.0 ? sumC / wC : c0;
 
 	float y = luma(lumaPart);
+
+	if (sharpenAmount > 0.0) {
+		float detail = y - sumB / wB;
+		detail = sign(detail) * max(abs(detail) - sharpenThreshold, 0.0);
+		const float margin = 0.02;
+		y = clamp(y + sharpenAmount * detail, yMin - margin, yMax + margin);
+	}
+
 	vec3 chroma = chromaPart - vec3(luma(chromaPart));
 	gl_FragColor = vec4(clamp(vec3(y) + chroma, 0.0, 1.0), 1.0);
 }
