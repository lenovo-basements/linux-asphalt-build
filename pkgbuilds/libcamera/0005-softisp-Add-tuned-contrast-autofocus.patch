+int32_t SwStatsCpu::measureFocus(const MappedFrameBuffer &in, Size size) const
+{
+	/* Compare same-phase green pixels in the central two thirds. */
+	const unsigned int left = (size.width / 6 + 7) & ~7u;
+	const unsigned int top = (size.height / 6 + 7) & ~7u;
+	const unsigned int right = size.width - left;
+	const unsigned int bottom = size.height - top;
+	const uint8_t *data = in.planes()[0].data();
+	uint64_t energy = 0, light = 0;
+	for (unsigned int y = top; y + 4 < bottom; y += 8) {
+		const uint8_t *row = data + y * stride_;
+		const uint8_t *below = row + 4 * stride_;
+		for (unsigned int x = left; x + 4 < right; x += 8) {
+			const unsigned int offset = x * 5 / 4 + 1;
+			const int green = row[offset];
+			const int horizontal = std::max(std::abs(green - row[offset + 5]) - 3, 0);
+			const int vertical = std::max(std::abs(green - below[offset]) - 3, 0);
+			energy += horizontal * horizontal + vertical * vertical;
+			light += green;
+		}
+	}
+
+	return light ? energy * 1024 / light : 0;
+}
