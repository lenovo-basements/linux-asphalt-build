+bool SimpleCameraData::moveContrastFocus(uint32_t frame, int32_t position)
+{
+	if (sensor_->focusLens()->setFocusPosition(position)) {
+		LOG(SimplePipeline, Warning) << "Failed to move focus lens to " << position;
+		contrastFocus_.enabled = false;
+		return false;
+	}
+
+	contrastFocus_.position = position;
+	/* Skip the in-flight frames and allow the actuator to settle. */
+	contrastFocus_.nextFrame = frame + 8;
+	return true;
+}
+
+void SimpleCameraData::updateContrastFocus(uint32_t frame, const ControlList &metadata)
+{
+	auto &af = contrastFocus_;
+	const auto score = metadata.get(controls::FocusFoM);
+	const auto exposure = metadata.get(controls::ExposureTime);
+	const auto gain = metadata.get(controls::AnalogueGain);
+	if (!af.enabled || !score || !exposure || !gain || frame < af.nextFrame)
+		return;
+
+	const double signal = *exposure * static_cast<double>(*gain);
+	const bool stable = af.exposure > 0.0 &&
+			    std::abs(signal - af.exposure) <= af.exposure * 0.03;
+	af.exposure = signal;
+
+	if (af.locked) {
+		if (!stable || *score <= 0) {
+			af.changedSamples = 0;
+			return;
+		}
+		if (!af.referenceScore) {
+			af.referenceScore = *score;
+			return;
+		}
+		if (std::abs(*score - af.referenceScore) < af.referenceScore * 0.25) {
+			af.changedSamples = 0;
+			return;
+		}
+		if (++af.changedSamples < 5)
+			return;
+		af.locked = false;
+		af.position = -1;
+		af.stableSamples = 0;
+	}
+
+	const auto &range = sensor_->focusLens()->controls().at(V4L2_CID_FOCUS_ABSOLUTE);
+	const int32_t min = range.min().get<int32_t>();
+	const int32_t max = range.max().get<int32_t>();
+	if (af.position < 0) {
+		af.stableSamples = stable ? af.stableSamples + 1 : 0;
+		if (af.stableSamples < 3 || *score <= 0)
+			return;
+		af.bestPosition = min;
+		af.bestScore = 0;
+		af.step = 128;
+		af.upper = max;
+		moveContrastFocus(frame, min);
+		return;
+	}
+
+	/* Do not compare positions while automatic exposure is moving. */
+	if (!stable)
+		return;
+
+	LOG(SimplePipeline, Debug) << "Contrast AF position " << af.position
+				   << " score " << *score;
+	if (*score > af.bestScore) {
+		af.bestScore = *score;
+		af.bestPosition = af.position;
+	}
+
+	if (af.position < af.upper) {
+		moveContrastFocus(frame, std::min(af.position + af.step, af.upper));
+		return;
+	}
+
+	if (af.step == 128) {
+		const int32_t coarse = af.bestPosition;
+		af.step = 32;
+		af.upper = std::min(coarse + 128, max);
+		moveContrastFocus(frame, std::max(coarse - 128, min));
+		return;
+	}
+
+	if (moveContrastFocus(frame, af.bestPosition)) {
+		af.locked = true;
+		af.referenceScore = 0;
+		af.changedSamples = 0;
+		LOG(SimplePipeline, Info) << "Contrast AF selected position " << af.bestPosition
+					  << " with score " << af.bestScore;
+	}
 }
 
