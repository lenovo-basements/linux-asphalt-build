--- /dev/null
+++ b/src/ipa/simple/algorithms/denoise.cpp
@@ -0,0 +1,83 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Denoise strength
+ *
+ * Tuning (per sensor), strengths piecewise linear in analogue gain:
+ *
+ *   - Denoise:
+ *       gain:   [ 1.0, 4.0, 16.0 ]
+ *       luma:   [ 0.0, 0.015, 0.04 ]
+ *       chroma: [ 0.0, 0.05, 0.12 ]
+ *
+ * luma / chroma are the denoise pass's range tolerances in gamma-encoded
+ * units (see denoise.frag). 0 for both skips the pass, so good light costs
+ * nothing.
+ */
+
+#include "denoise.h"
+
+#include <algorithm>
+
+#include <libcamera/base/log.h>
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+LOG_DEFINE_CATEGORY(IPASoftDenoise)
+
+static int readList(const ValueNode &node, std::vector<float> &out)
+{
+	if (!node.isList())
+		return -EINVAL;
+	for (const auto &value : node.asList()) {
+		const auto v = value.get<float>();
+		if (!v)
+			return -EINVAL;
+		out.push_back(*v);
+	}
+	return 0;
+}
+
+int Denoise::init([[maybe_unused]] IPAContext &context, const ValueNode &tuningData)
+{
+	if (readList(tuningData["gain"], gains_) || readList(tuningData["luma"], luma_) ||
+	    readList(tuningData["chroma"], chroma_) || gains_.empty() ||
+	    luma_.size() != gains_.size() || chroma_.size() != gains_.size() ||
+	    !std::is_sorted(gains_.begin(), gains_.end())) {
+		LOG(IPASoftDenoise, Error)
+			<< "Denoise needs 'gain', 'luma' and 'chroma' lists of the same"
+			<< " length, gain ascending";
+		return -EINVAL;
+	}
+	return 0;
+}
+
+float Denoise::lookup(const std::vector<float> &gains,
+		      const std::vector<float> &values, float gain)
+{
+	if (gain <= gains.front())
+		return values.front();
+	if (gain >= gains.back())
+		return values.back();
+	auto it = std::upper_bound(gains.begin(), gains.end(), gain);
+	const size_t i = it - gains.begin();
+	const float t = (gain - gains[i - 1]) / (gains[i] - gains[i - 1]);
+	return values[i - 1] + t * (values[i] - values[i - 1]);
+}
+
+void Denoise::prepare(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      DebayerParams *params)
+{
+	const float gain = context.activeState.agc.again;
+
+	params->denoiseLuma = std::max(0.0f, lookup(gains_, luma_, gain));
+	params->denoiseChroma = std::max(0.0f, lookup(gains_, chroma_, gain));
+}
+
+REGISTER_IPA_ALGORITHM(Denoise, "Denoise")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
