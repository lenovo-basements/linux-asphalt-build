pkgbase=libcamera
pkgname=(libcamera libcamera-ipa libcamera-tools)
pkgver=0.7.2
pkgrel=4.1
pkgdesc="A complex camera support library for Linux, Android, and ChromeOS (asphalt sensor helpers)"
arch=(aarch64)
url="https://libcamera.org/"
_url=https://git.libcamera.org/libcamera/libcamera.git
makedepends=(
  git meson cmake
  gnutls libelf libunwind libyaml libyuv libpisp systemd libglvnd
  libdrm libjpeg-turbo libtiff libevent sdl2
  python-jinja python-ply python-pyyaml
)
source=(
  "git+$_url#tag=v$pkgver"
  0001-libipa-camera_sensor_helper-Add-OV13B10-helper-and-s.patch
  0002-libipa-camera_sensor_helper-Add-S5K4H7-helper-and-se.patch
  0003-libipa-camera_sensor_helper-Add-SC202CS-helper-and-s.patch
)
sha512sums=('a5656356617a01a7e8feb535380869d38b7c58139c7f99385af355629d3e1927bbd8847f7bec755c753c72f6b065df76de53c15f9af2e5901e83e7a144a2ddcd'
            SKIP SKIP SKIP)

_pick() {
  local p="$1" f d; shift
  for f; do
    [[ -e $f ]] || continue
    d="$srcdir/$p/${f#$pkgdir/}"
    mkdir -p "$(dirname "$d")"
    mv "$f" "$d"
    rmdir -p --ignore-fail-on-non-empty "$(dirname "$f")"
  done
}

prepare() {
  cd $pkgbase
  local p
  for p in "$srcdir"/000*.patch; do
    echo "Applying ${p##*/}"
    git apply --whitespace=nowarn "$p"
  done
  printf "%s\n" "$pkgver" > .tarball-version
}

build() {
  local meson_options=(
    -D v4l2=enabled
    -D tracing=disabled
    -D test=false
    -D documentation=disabled
    -D qcam=disabled
    -D lc-compliance=disabled
    -D pycamera=disabled
    -D gstreamer=disabled
    -D rpi-awb-nn=disabled
    -D werror=false  # GCC 16 -Warray-bounds false positive on std::mutex placement new
  )
  arch-meson $pkgbase build "${meson_options[@]}"
  meson compile -C build
}

package_libcamera() {
  license=(Apache-2.0 CC0-1.0 'GPL-2.0-only WITH Linux-syscall-note' GPL-2.0-or-later
           LGPL-2.1-or-later 'GPL-2.0-or-later WITH Linux-syscall-note OR BSD-3-Clause'
           'GPL-2.0-or-later WITH Linux-syscall-note OR MIT')
  depends=(glibc gnutls libcamera-ipa libelf libgcc libglvnd libpisp libstdc++ libunwind
           libyaml libyuv sh systemd-libs libudev.so)
  optdepends=('libcamera-tools: for applications')
  provides=(libcamera.so libcamera-base.so)

  meson install -C build --destdir "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/{BSD-3-Clause,Linux-syscall-note,MIT}.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
  (
    cd "$pkgdir"
    _pick $pkgbase-ipa usr/lib/libcamera/
    _pick $pkgbase-tools usr/bin/{cam,libcamera-bug-report}
    rm -rf usr/share/doc
  )
}

package_libcamera-ipa() {
  pkgdesc+=" - signed IPA"
  license=(BSD-2-Clause CC-BY-SA-4.0 CC0-1.0 GPL-2.0-or-later LGPL-2.1-or-later)
  depends=(glibc libcamera libcamera.so libcamera-base.so libgcc libstdc++)
  # stripping requires re-signing of IPA libs, so we do it manually
  options=(!strip)

  strip $pkgname/usr/lib/libcamera/*{.so,proxy}
  for _lib in $pkgname/usr/lib/libcamera/*.so; do
    $pkgbase/src/ipa/ipa-sign.sh "$(find build -type f -iname "*ipa-priv-key.pem")" "$_lib" "$_lib.sign"
  done
  mv -v $pkgname/* "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/BSD-2-Clause.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}

package_libcamera-tools() {
  pkgdesc+=" - tools"
  license=(BSD-2-Clause CC0-1.0 GPL-2.0-or-later LGPL-2.1-or-later)
  depends=(glibc libcamera libcamera.so libcamera-base.so libdrm libevent libevent-2.1.so
           libevent_pthreads-2.1.so libgcc libjpeg-turbo libjpeg.so libstdc++ libtiff libtiff.so
           libyaml sdl2)

  mv -v $pkgname/* "$pkgdir"
  install -vDm 644 $pkgbase/LICENSES/BSD-2-Clause.txt -t "$pkgdir/usr/share/licenses/$pkgname/"
}
