_units() { sed -n 's/^enable //p' /usr/lib/systemd/system-preset/80-asphalt.preset; }

post_install() {
  if ! cmp -s /usr/share/asphalt/tuned-ppd.conf /etc/tuned/ppd.conf 2>/dev/null; then
    echo ":: For the asphalt power profiles, use the asphalt tuned-ppd mapping:"
    echo "   cp /usr/share/asphalt/tuned-ppd.conf /etc/tuned/ppd.conf"
  fi
  echo ":: Enable the device services with:"
  echo "   systemctl preset $(_units | tr '\n' ' ')"
}

post_upgrade() {
  if ! cmp -s /usr/share/asphalt/tuned-ppd.conf /etc/tuned/ppd.conf 2>/dev/null; then
    echo ":: /usr/share/asphalt/tuned-ppd.conf differs from /etc/tuned/ppd.conf"
  fi
}
