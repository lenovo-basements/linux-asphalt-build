# Device support for the Lenovo Legion Y700 Gen 2 (asphalt): the daemons,
# units, udev rules, audio (UCM + WirePlumber), power profiles, haptics and
# sensor glue from linux-asphalt-build's rootfs/, laid out the Arch way:
# programs in /usr/bin, units and drop-ins under /usr/lib, so /etc stays
# yours. Built from this checkout (the PKGBUILD lives in the repo it packages).
#
# Services are not enabled on install (Arch convention). Enable the set the
# image uses with the shipped preset:
#   systemctl preset $(sed -n 's/^enable //p' /usr/lib/systemd/system-preset/80-asphalt.preset)
pkgname=asphalt-device-support
pkgver=r0
pkgrel=1
pkgdesc="Device support for the Lenovo Legion Y700 Gen 2 (asphalt)"
arch=(any)
url="https://github.com/lenovo-basements/linux-asphalt-build"
license=(GPL-2.0-or-later)
depends=(
  asphalt-firmware hexagonrpc pd-mapper qrtr sensh
  python python-evdev
  alsa-ucm-conf wireplumber iio-sensor-proxy libssc
  tuned tuned-ppd zram-generator
  bluez bluez-utils iproute2 polkit zstd glib2
)
optdepends=(
  'feedbackd: keyboard haptics (squeekboard) through the device theme'
  'gnome-shell: the asphalt-haptics extension'
  'chromium: the asphalt-chromium launcher (V4L2 hardware decode)'
  'libcamera: cameras (pkgbuilds/libcamera adds the sensor helpers)'
)
backup=(etc/libcamera/ipa/simple/ov13b10.yaml
        etc/libcamera/ipa/simple/s5k4h7.yaml
        etc/libcamera/ipa/simple/sc202cs.yaml)
install=asphalt-device-support.install
# ASPHALT_BUILD_DIR: this repo, when building from a copy of pkgbuilds/.
_repo="${ASPHALT_BUILD_DIR:-$startdir/../..}"
_root="$_repo/rootfs"

pkgver() {
  cd "$_repo"
  printf "r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
  local r="$_root" d="$pkgdir"

  # Programs (regular files only: a stray __pycache__ must not slip in).
  find "$r/usr/local/bin" -maxdepth 1 -type f -exec install -Dm755 -t "$d/usr/bin/" {} +
  install -Dm644 -t "$d/usr/share/applications/" "$r/usr/share/applications/asphalt-chromium.desktop"

  # systemd: units, drop-ins, sleep hooks, logind/sleep/zram config.
  install -Dm644 -t "$d/usr/lib/systemd/system/" "$r"/etc/systemd/system/*.service "$r"/etc/systemd/system/*.socket
  install -Dm644 -t "$d/usr/lib/systemd/system/service.d/" "$r"/etc/systemd/system/service.d/*.conf
  install -Dm644 -t "$d/usr/lib/systemd/system/iio-sensor-proxy.service.d/" "$r"/etc/systemd/system/iio-sensor-proxy.service.d/*.conf
  install -Dm755 -t "$d/usr/lib/systemd/system-sleep/" "$r"/usr/lib/systemd/system-sleep/*
  install -Dm644 -t "$d/usr/lib/systemd/logind.conf.d/" "$r"/etc/systemd/logind.conf.d/*.conf
  install -Dm644 "$r/etc/systemd/sleep.conf" "$d/usr/lib/systemd/sleep.conf.d/50-asphalt.conf"
  install -Dm644 "$r/etc/systemd/zram-generator.conf" "$d/usr/lib/systemd/zram-generator.conf"
  install -Dm644 -t "$d/usr/lib/sysusers.d/" "$r"/usr/lib/sysusers.d/*.conf
  install -Dm644 -t "$d/usr/lib/tmpfiles.d/" "$r"/etc/tmpfiles.d/*.conf
  install -Dm644 -t "$d/usr/lib/sysctl.d/" "$r"/etc/sysctl.d/*.conf
  install -Dm644 /dev/stdin "$d/usr/lib/systemd/system-preset/80-asphalt.preset" <<'PRESET'
# Units the asphalt image enables (systemctl preset <unit>...).
enable pd-mapper.service
enable hexagonrpcd-sdsp.service
enable asphalt-touch-rightclick.service
enable asphalt-lid-daemon.service
enable asphalt-power-button.service
enable asphalt-resume-guard.service
enable asphalt-suspend-sensors.service
enable asphalt-bluetooth-setup.service
enable asphalt-wifi-mac.service
enable asphalt-hapticd.socket
enable asphalt-hapticd-fifo.socket
enable asphalt-hapticd-control.socket
enable tuned.service
enable tuned-ppd.service
PRESET

  # udev, polkit
  install -Dm644 -t "$d/usr/lib/udev/rules.d/" "$r"/etc/udev/rules.d/*.rules
  install -Dm644 -t "$d/usr/share/polkit-1/rules.d/" "$r"/etc/polkit-1/rules.d/*.rules
  install -Dm644 -t "$d/usr/share/polkit-1/actions/" "$r"/usr/share/polkit-1/actions/*.policy

  # Audio: UCM profile, WirePlumber config.
  local ucm="$d/usr/share/alsa/ucm2"
  install -Dm644 -t "$ucm/Qualcomm/sm8450/Lenovo-Asphalt/" "$r"/usr/share/alsa/ucm2/Qualcomm/sm8450/Lenovo-Asphalt/*.conf
  install -Dm644 -t "$ucm/conf.d/sm8450/" "$r/usr/share/alsa/ucm2/conf.d/sm8450/Lenovo-Asphalt.conf"
  install -Dm644 -t "$d/usr/share/wireplumber/wireplumber.conf.d/" "$r"/etc/wireplumber/wireplumber.conf.d/*.conf

  # Cameras: soft-IPA tuning (libcamera reads /etc/libcamera/ipa first).
  install -Dm644 -t "$d/etc/libcamera/ipa/simple/" "$r"/etc/libcamera/ipa/simple/*.yaml

  # Power profiles. tuned-ppd only reads /etc/tuned/ppd.conf (owned by
  # tuned-ppd), so the mapping ships here and the .install points it out.
  install -d "$d/usr/lib/tuned/profiles"
  cp -r --no-preserve=ownership "$r"/etc/tuned/profiles/asphalt-* "$d/usr/lib/tuned/profiles/"
  install -Dm644 "$r/etc/tuned/ppd.conf" "$d/usr/share/asphalt/tuned-ppd.conf"

  # Haptics: feedbackd device theme (looked up by DT compatible, /usr/share
  # only) and the GNOME extension.
  install -Dm644 -t "$d/usr/share/feedbackd/themes/" "$r"/usr/local/share/feedbackd/themes/*.json
  local ext=usr/share/gnome-shell/extensions/asphalt-haptics@lenovo.local
  install -Dm644 -t "$d/$ext/" "$r/$ext"/{extension.js,metadata.json}

  # /usr/local was the old prefix: point everything at the packaged paths.
  grep -rlIZ -e /usr/local/bin -e /usr/local/share "$d" | xargs -0r sed -i \
    -e 's|/usr/local/bin/|/usr/bin/|g' \
    -e 's|/usr/local/share/feedbackd|/usr/share/feedbackd|g'
  if grep -rIn /usr/local "$d"; then
    echo "error: /usr/local references left" >&2
    return 1
  fi
}
