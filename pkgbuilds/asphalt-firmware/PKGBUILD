# Device firmware for the Lenovo Legion Y700 Gen 2 (TB320FC), from the sibling
# asphalt-firmware repository: GPU (sqe/gmu/zap), Iris VPU, DSPs, ath11k
# WCN6855, QCA BT, Cirrus amps, Novatek touch, Awinic haptics (including the
# RTP effects), plus the stock SSC sensor configs hexagonrpcd/sensh read.
# Complete for the device: stock linux-firmware is only for extra USB gear.
#
#   ASPHALT_FIRMWARE_DIR=/path/to/asphalt-firmware makepkg -f
#   (default: ../../../asphalt-firmware, next to linux-asphalt-build)
pkgname=asphalt-firmware
pkgver=r0
pkgrel=1
pkgdesc="Firmware and sensor configs for the Lenovo Legion Y700 Gen 2 (TB320FC)"
arch=(any)
url="https://github.com/lenovo-basements/asphalt-firmware"
license=(LicenseRef-proprietary-redistributable)
options=(!strip !debug)
_src="${ASPHALT_FIRMWARE_DIR:-$startdir/../../../asphalt-firmware}"

pkgver() {
  cd "$_src"
  printf "r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

package() {
  cd "$_src"
  local fw="$pkgdir/usr/lib/firmware"
  install -d "$fw"
  local comp
  for comp in ath11k cirrus novatek qca qcom awinic; do
    [[ -d $comp ]] && cp -r --no-preserve=ownership "$comp" "$fw/"
  done
  # Sensor configs aren't firmware: hexagonrpcd reads /usr/share/qcom/sensors.
  rm -rf "$fw/qcom/sensors"
  install -d "$pkgdir/usr/share/qcom/sensors"
  cp -r --no-preserve=ownership qcom/sensors/config "$pkgdir/usr/share/qcom/sensors/"
  install -m644 qcom/sensors/sns_reg.conf "$pkgdir/usr/share/qcom/sensors/"
  # The touch driver asks for the generic name when it rebinds.
  ln -s tb320fc-nt36523n.bin "$fw/novatek/novatek_ts_fw.bin"
  find "$pkgdir" -name '._*' -delete
  find "$fw" -type f -exec chmod 644 {} +
}
