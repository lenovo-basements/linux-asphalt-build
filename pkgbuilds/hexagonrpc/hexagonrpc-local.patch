+	return lseek(ctx->fd, off, whence);
+}
+
+static int temp_file_stat(struct hexagonfs_fd *fd, struct stat *stats)
+{
+	struct temp_file_ctx *ctx = fd->data;
+	return fstat(ctx->fd, stats);
+}
+
+static ssize_t temp_file_write(struct hexagonfs_fd *fd, size_t size, const void *in)
+{
+	struct temp_file_ctx *ctx = fd->data;
+	return write(ctx->fd, in, size);
+}
+
+static struct hexagonfs_file_ops temp_file_ops = {
+	.close = temp_file_close,
