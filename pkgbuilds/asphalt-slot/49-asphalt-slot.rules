// The power menu's "Reboot to Android": an active, local administrator may
// switch to slot a and reboot without a password. Every other use of
// asphalt-slot through pkexec still asks for one.
polkit.addRule(function(action, subject) {
    if (action.id !== 'local.lenovo.asphalt.slot')
        return;

    if (action.lookup('program') === '/usr/bin/asphalt-slot' &&
        action.lookup('command_line') === '/usr/bin/asphalt-slot reboot a' &&
        subject.local && subject.active && subject.isInGroup('wheel')) {
        return polkit.Result.YES;
    }
});
