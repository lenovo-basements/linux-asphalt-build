# Pen mode for the TB320FC touchscreen: switches the NT36523N to pen mode
# while a Bluetooth pen is connected (udev + asphalt-pen).
#
#   ASPHALT_PEN_DIR=/path/to/asphalt-pen-service makepkg -f
#   (default: ../../../asphalt-pen-service, next to linux-asphalt-build)
pkgname=asphalt-pen-service
pkgver=r0
pkgrel=1
pkgdesc="Pen mode switcher for the Lenovo Legion Y700 Gen 2 touchscreen"
arch=(any)
url="https://github.com/lenovo-basements/asphalt-pen-service"
license=(LicenseRef-unknown) # no LICENSE in the repo yet
depends=(python)
backup=(etc/asphalt-pen.conf)
_src="${ASPHALT_PEN_DIR:-$startdir/../../../asphalt-pen-service}"

check() {
  cd "$_src"
  python -B -m unittest discover -s tests
}

package() {
  cd "$_src"
  make install DESTDIR="$pkgdir" PREFIX=/usr SYSCONFDIR=/etc
}
